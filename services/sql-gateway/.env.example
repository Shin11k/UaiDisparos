# Copie como .env no SERVIDOR. Nunca suba o arquivo .env ao GitHub.
# Preencha os dados do PostgreSQL local.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=uaidisparos
PGUSER=uai_app
PGPASSWORD=SUBSTITUIR_NO_SERVIDOR
# O gateway escuta SOMENTE localhost. Cloudflare Tunnel encaminhará o tráfego.
UAI_GATEWAY_HOST=127.0.0.1
UAI_GATEWAY_PORT=3107
# Crie uma chave com pelo menos 32 caracteres aleatórios.
UAI_GATEWAY_TOKEN=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
# Marque true somente se o PostgreSQL local exigir TLS
PGSSL=false
